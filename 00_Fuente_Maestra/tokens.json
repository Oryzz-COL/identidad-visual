      "300": "#C7CBD6", "200": "#D5D9E0", "100": "#E5E8EE", "50": "#F6F7F9", "0": "#FFFFFF"
    },
    "azul": { "50": "#EEF3FF", "300": "#9FB8FF", "400": "#5C8BFF", "500": "#3B72FF", "600": "#2C5BD0", "700": "#1F43A0", "900": "#0F1E4A" },
    "cyan": { "50": "#E8FAFC", "300": "#7DE6F2", "500": "#36CFE0", "600": "#17A9C2" },
    "lima": { "50": "#F4FCE0", "300": "#E4F7B4", "500": "#BFF24A", "600": "#7FB02E", "900": "#3A4A12" },
    "estado": { "exito": "#1F9D55", "aviso": "#F2A33A", "error": "#E5484D" }
  },
  "gradient": {
    "ia-oscuro": "linear-gradient(135deg, #5C8BFF 0%, #36CFE0 100%)",
    "ia-claro": "linear-gradient(135deg, #3B72FF 0%, #17A9C2 100%)"
  },
  "semantic": {
    "oscuro": {
      "fondo": "#0B0D12", "superficie": "#12151D", "superficie-2": "#171B25", "borde": "#232836",
      "texto": "#FFFFFF", "texto-2": "#D5D9E0", "texto-3": "#8A90A0",
      "acento": "#5C8BFF", "enlace": "#9FB8FF", "dato": "#BFF24A",
      "cta-fondo": "gradient.ia-oscuro", "cta-texto": "#0B0D12"
    },
    "claro": {
      "fondo": "#FFFFFF", "superficie": "#F6F7F9", "superficie-2": "#E5E8EE", "borde": "#D5D9E0",
      "texto": "#0B0D12", "texto-2": "#3A4152", "texto-3": "#5A6172",
      "acento": "#3B72FF", "enlace": "#2C5BD0", "dato": "#7FB02E",
      "cta-fondo": "#2C5BD0", "cta-texto": "#FFFFFF"
    }
  },
  "font": {
    "display": { "family": "Space Grotesk", "weights": [500, 600, 700], "fallback": "Arial, Helvetica, sans-serif" },
    "texto": { "family": "Manrope", "weights": [400, 500, 600, 700, 800], "fallback": "Arial, Helvetica, sans-serif" },
    "mono": { "family": "JetBrains Mono", "weights": [400, 500, 700], "fallback": "Consolas, 'Courier New', monospace" }
  },
  "type-scale-px": {
    "display-xl": { "size": 96, "line": 0.95, "tracking": "-0.045em", "font": "display", "weight": 700 },
    "display-l":  { "size": 72, "line": 1.0,  "tracking": "-0.04em",  "font": "display", "weight": 700 },
    "h1":         { "size": 56, "line": 1.05, "tracking": "-0.035em", "font": "display", "weight": 700 },
    "h2":         { "size": 40, "line": 1.1,  "tracking": "-0.03em",  "font": "display", "weight": 700 },
    "h3":         { "size": 28, "line": 1.2,  "tracking": "-0.02em",  "font": "display", "weight": 600 },
    "h4":         { "size": 20, "line": 1.3,  "tracking": "-0.01em",  "font": "display", "weight": 600 },
    "lead":       { "size": 20, "line": 1.55, "tracking": "0",        "font": "texto",   "weight": 400 },
    "body":       { "size": 16, "line": 1.6,  "tracking": "0",        "font": "texto",   "weight": 400 },
    "small":      { "size": 14, "line": 1.5,  "tracking": "0",        "font": "texto",   "weight": 500 },
    "eyebrow":    { "size": 14, "line": 1.3,  "tracking": "0",        "font": "texto",   "weight": 600, "case": "sentence" },
    "dato":       { "size": 64, "line": 1.0,  "tracking": "-0.03em",  "font": "display", "weight": 500 }
  },
  "space-px": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192],
  "radius-px": { "xs": 6, "s": 10, "m": 14, "l": 20, "xl": 28, "pill": 999, "app-icon": "22.5%" },
  "radius-uso": { "boton": "m", "tarjeta": "m" },
  "stroke-px": { "hairline": 1, "icono": 1.75, "grafico": 2 },
  "grid": { "web": "12 col · 24px gutter · max 1200px", "slides-16x9": "12 col · 1920x1080 · margen 120px · gutter 32px", "a4": "margen 20mm · 6 col · gutter 5mm" },
  "motion": { "ease-marca": "cubic-bezier(.2,.8,.2,1)", "ease-salto": "cubic-bezier(.34,1.4,.5,1)", "rapido": "160ms", "base": "280ms", "lento": "560ms", "orbita": "4.4s linear infinite" }
}
